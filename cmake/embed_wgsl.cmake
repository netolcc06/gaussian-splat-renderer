# Script mode (cmake -P): writes a C++ file that embeds every shaders/wgsl/*.wgsl as a byte
# array, plus a name -> text table (src/webgpu/wgsl_sources.h).
#   cmake -DWGSL_DIR=<dir> -DOUTPUT=<file.cpp> -P embed_wgsl.cmake
if(NOT WGSL_DIR OR NOT OUTPUT)
  message(FATAL_ERROR "embed_wgsl.cmake: WGSL_DIR and OUTPUT are required")
endif()

file(GLOB files RELATIVE ${WGSL_DIR} ${WGSL_DIR}/*.wgsl)
list(SORT files)

set(arrays "")
set(entries "")
set(index 0)
foreach(name ${files})
  file(READ ${WGSL_DIR}/${name} hex HEX)
  string(LENGTH "${hex}" hexLength)
  math(EXPR byteCount "${hexLength} / 2")
  # "0a1b..." -> "0x0a,0x1b,...", 16 bytes per line.
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")
  string(APPEND arrays "// ${name} (${byteCount} bytes)\nconst unsigned char kFile${index}[] = {\n    ${bytes}0x00};\n\n")
  string(APPEND entries "    {\"${name}\", std::string_view(reinterpret_cast<const char*>(kFile${index}), ${byteCount})},\n")
  math(EXPR index "${index} + 1")
endforeach()

set(content "// Generated by cmake/embed_wgsl.cmake from shaders/wgsl/*.wgsl. Do not edit.\n")
string(APPEND content "#include \"webgpu/wgsl_sources.h\"\n\nnamespace gsr {\nnamespace {\n\n${arrays}")
string(APPEND content "const WgslSourceFile kFiles[] = {\n${entries}};\n\n}  // namespace\n\n")
string(APPEND content "std::span<const WgslSourceFile> embeddedWgslFiles() { return kFiles; }\n\n}  // namespace gsr\n")

file(WRITE ${OUTPUT} "${content}")
