#version 460
// Phase 0 compute pass: fills the render target with a background gradient.
// It only exists to prove the compute path works (pipeline, descriptor set,
// storage image, barrier into the graphics pass, timestamps).

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outImage;

layout(push_constant) uniform PushConstants {
    ivec2 size;  // render target size in pixels
} pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.size.x || pixel.y >= pc.size.y) return;  // partial edge groups

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.size);
    vec3 top = vec3(0.10, 0.12, 0.22);
    vec3 bottom = vec3(0.30, 0.18, 0.32);
    vec3 color = mix(top, bottom, uv.y) + vec3(0.08 * uv.x, 0.0, 0.0);
    imageStore(outImage, pixel, vec4(color, 1.0));
}
